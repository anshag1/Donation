# Copy to .env and fill in. Blank values are fine for local-first development —
# see docs/08-local-development.md for what works without real credentials.

ENVIRONMENT=development

# --- Database ---
DATABASE_URL=postgresql+psycopg://donation:donation@localhost:5435/donation_dev

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:3000

# --- Razorpay ---
# Leave blank to run locally without a Razorpay account (order creation will
# return a clear config error; the webhook path can still be exercised with
# the signed-webhook script in docs/08-local-development.md).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Resend (email) ---
# Leave blank to run locally without sending real email — the email service
# will log the would-be send instead of failing.
RESEND_API_KEY=
RESEND_FROM_EMAIL=receipts@example.org

# --- Object storage ---
# Leave all three blank to use local-filesystem storage under backend/var/receipts/.
# Fill in all three to use Supabase Storage instead.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# --- Misc ---
DEFAULT_ORG_RECEIPT_PREFIX=DEMO
